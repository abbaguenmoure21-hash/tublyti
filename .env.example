# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# YouTube
YOUTUBE_API_KEY=
YT_QUOTA_SOFT_LIMIT=8000

# AI
ANTHROPIC_API_KEY=
AI_BUDGET_USD=30

# Embeddings (Voyage AI via MongoDB Atlas)
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_BASE_URL=https://ai.mongodb.com/v1

# Trends
SERPAPI_KEY=
TREND_PROVIDER=serpapi

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Email
RESEND_API_KEY=
ALERT_EMAIL=

# Cron & MCP
CRON_SECRET=
MCP_TOKEN=

# Auth
ALLOW_SIGNUP=false
# Adresses toujours administratrices (console d'admin), séparées par des virgules
ADMIN_EMAILS=

# Connexion Google (preuve de propriété des chaînes YouTube) — Google Cloud › Identifiants › ID client OAuth (Web)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Clé de chiffrement des jetons YouTube Analytics (32 octets en base64) : openssl rand -base64 32
# Ne jamais la changer après coup : les jetons enregistrés deviendraient illisibles.
TOKEN_ENCRYPTION_KEY=
# Adresse publique de l'app (sert aussi à l'adresse de retour Google), ex. https://tublyti.vercel.app
NEXT_PUBLIC_APP_URL=
# Adresse de contact affichée sur la page Confidentialité
NEXT_PUBLIC_CONTACT_EMAIL=

# Classement des chaînes candidates par l'IA (Claude Haiku, ~0,002 $ par chaîne, plafonné par AI_BUDGET_USD)
CANDIDATE_AI_CLASSIFY=false

# Analyse du contenu des vidéos (image, audio, texte à l'écran) par Gemini, à la demande.
# Clé gratuite sur https://aistudio.google.com/apikey — aussi dans Vercel (pas besoin dans GitHub).
# Coût indicatif : ~0,2 à 0,6 centime par minute de vidéo, compté dans AI_BUDGET_USD. Résultat gardé en cache.
GEMINI_API_KEY=
# Modèle(s) à essayer, séparés par des virgules (défaut : gemini-3.1-flash-lite, puis repli automatique)
# GEMINI_VIDEO_MODEL=gemini-3.1-flash-lite
# VIDEO_ANALYSIS_MAX_MIN=60
# VIDEO_ANALYSIS_DAILY=15
